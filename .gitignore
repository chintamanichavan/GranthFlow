# Anyfile: C++ engine and Mac app
build/
*.blend1
design/*.png
mac/build/
xcuserdata/
*.xcuserstate

# granthflow PWA: the WebAssembly build tree. web/vendor/anyfile.{mjs,wasm} are committed on
# purpose, so the app can be served from any static host without the Emscripten SDK installed.
build-wasm/
build-wasm-debug/

# granthflow: Python web reader
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/

# user data lives outside the repo when deployed; keep dir but ignore content
data/files/*
data/covers/*
data/*.db
data/*.db-journal
!data/files/.gitkeep
!data/covers/.gitkeep
